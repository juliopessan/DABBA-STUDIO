# Provider padrão, na ordem: gemini (se GEMINI_API_KEY definida), openrouter
# (se OPENROUTER_API_KEY) ou anthropic (se DABBA_LLM_API_KEY). Sem nenhuma,
# roda em modo dry-run. Definir aqui força um provider específico.
DABBA_LLM_PROVIDER=gemini

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Opcional — sem isso usa gemini-3.7-flash.
# DABBA_GEMINI_MODEL=gemini-3.7-flash

OPENROUTER_API_KEY=
# Lista de modelos free, em ordem de tentativa (fallback automático em
# erro/429/quota). Opcional — sem isso usa a lista default do código.
# DABBA_OPENROUTER_MODELS=nvidia/nemotron-nano-9b-v2:free,openai/gpt-oss-20b:free

DABBA_LLM_API_KEY=
DABBA_LLM_MODEL=claude-sonnet-5
